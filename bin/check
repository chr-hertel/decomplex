#!/usr/bin/env bash

symfony composer validate --strict
symfony composer check-platform-reqs

symfony console lint:yaml config --parse-tags
symfony console lint:twig templates
symfony console lint:container

symfony php vendor/bin/php-cs-fixer fix --dry-run
npm run check-style

npm audit

symfony php vendor/bin/phpstan analyse

symfony composer install --working-dir=tools/phpmd
symfony php tools/phpmd/vendor/bin/phpmd src ansi ruleset.xml --baseline-file phpmd-baseline.xml

symfony php vendor/bin/phpunit

# Mutation testing is currently unavailable: infection >= 0.28 needs nikic/php-parser ^5,
# but niels-de-blaauw/php-doc-check pins the app to ^4, and infection resolves php-parser
# through the project autoloader even when installed standalone or as a phar.
# Re-enable (see infection.json.dist) once php-doc-check supports php-parser ^5.
